@model IReadOnlyList<HrSystem.Domain.Entities.EmployeeEmergencyContact>

@{
    var employee = (HrSystem.Domain.Entities.Employee)ViewData["Employee"]!;
    ViewData["Title"] = "Emergency Contacts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Emergency Contacts</h1>
        <div class="text-muted">@employee.EmployeeCode - @employee.FirstName @employee.LastName</div>
    </div>
    <a class="btn btn-primary" asp-action="Create" asp-route-employeeId="@employee.Id">Add</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Relationship</th>
            <th>Phone</th>
            <th>Primary</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Relationship</td>
                <td>@c.Phone</td>
                <td>@(c.IsPrimary ? "Yes" : "No")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-secondary" asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id">Back</a>

