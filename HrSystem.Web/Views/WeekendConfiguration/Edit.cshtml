@model HrSystem.Web.ViewModels.WeekendConfigurationVm

@{
    ViewData["Title"] = "Edit Weekend Configuration";
}

<h1 class="h3">Edit Weekend Configuration</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-3"><div class="form-check"><input asp-for="Sunday" class="form-check-input" /><label asp-for="Sunday" class="form-check-label">Sunday</label></div></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="Monday" class="form-check-input" /><label asp-for="Monday" class="form-check-label">Monday</label></div></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="Tuesday" class="form-check-input" /><label asp-for="Tuesday" class="form-check-label">Tuesday</label></div></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="Wednesday" class="form-check-input" /><label asp-for="Wednesday" class="form-check-label">Wednesday</label></div></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="Thursday" class="form-check-input" /><label asp-for="Thursday" class="form-check-label">Thursday</label></div></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="Friday" class="form-check-input" /><label asp-for="Friday" class="form-check-label">Friday</label></div></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="Saturday" class="form-check-input" /><label asp-for="Saturday" class="form-check-label">Saturday</label></div></div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a class="btn btn-outline-secondary mt-3" asp-action="Index">Cancel</a>
</form>

