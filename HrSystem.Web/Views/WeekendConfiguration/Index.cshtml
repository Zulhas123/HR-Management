@model HrSystem.Domain.Entities.WeekendConfiguration?

@{
    ViewData["Title"] = "Weekend Configuration";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Weekend Configuration</h1>
    <a class="btn btn-primary" asp-action="Edit">Edit</a>
</div>

@if (Model is null)
{
    <div class="alert alert-warning">No weekend configuration found.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Day</th>
                <th>Weekend</th>
            </tr>
        </thead>
        <tbody>
            <tr><td>Sunday</td><td>@(Model.Sunday ? "Yes" : "No")</td></tr>
            <tr><td>Monday</td><td>@(Model.Monday ? "Yes" : "No")</td></tr>
            <tr><td>Tuesday</td><td>@(Model.Tuesday ? "Yes" : "No")</td></tr>
            <tr><td>Wednesday</td><td>@(Model.Wednesday ? "Yes" : "No")</td></tr>
            <tr><td>Thursday</td><td>@(Model.Thursday ? "Yes" : "No")</td></tr>
            <tr><td>Friday</td><td>@(Model.Friday ? "Yes" : "No")</td></tr>
            <tr><td>Saturday</td><td>@(Model.Saturday ? "Yes" : "No")</td></tr>
        </tbody>
    </table>
}

