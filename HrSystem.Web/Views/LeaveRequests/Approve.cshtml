@model HrSystem.Web.ViewModels.LeaveDecisionVm

@{
    ViewData["Title"] = "Approve Leave";
}

<h1 class="h3">Approve Leave Request</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="DecisionNote" class="form-label">Note (optional)</label>
        <textarea asp-for="DecisionNote" class="form-control"></textarea>
        <span asp-validation-for="DecisionNote" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Approve</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

