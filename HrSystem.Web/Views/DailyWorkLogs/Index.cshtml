@model IReadOnlyList<HrSystem.Domain.Entities.DailyWorkLog>

@{
    ViewData["Title"] = "Daily Work Logs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Daily Work Logs</h1>
    <a class="btn btn-primary" asp-action="Create">New Log</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Employee</th>
            <th>Minutes</th>
            <th>WFH</th>
            <th>Task</th>
            <th>Summary</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.Date</td>
                <td>@(l.Employee?.EmployeeCode ?? l.EmployeeId.ToString())</td>
                <td>@l.MinutesWorked</td>
                <td>@(l.IsWorkFromHome ? "Yes" : "No")</td>
                <td>@(l.EmployeeTask?.Title ?? "")</td>
                <td>@l.Summary</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@l.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@l.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

