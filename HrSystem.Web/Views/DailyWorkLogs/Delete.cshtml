@model HrSystem.Domain.Entities.DailyWorkLog

@{
    ViewData["Title"] = "Delete Work Log";
}

<h1 class="h3">Delete Work Log</h1>

<div class="alert alert-warning mt-3">
    Are you sure you want to delete this work log for <strong>@(Model.Employee?.EmployeeCode ?? Model.EmployeeId.ToString())</strong> on <strong>@Model.Date</strong>?
</div>

<form method="post" asp-action="DeleteConfirmed">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

