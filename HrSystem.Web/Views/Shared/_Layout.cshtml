<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HrSystem.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="app-topbar navbar navbar-dark bg-primary px-3">
            <button class="btn btn-sm btn-outline-light me-2 d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Toggle sidebar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">HR System</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white-50 small d-none d-sm-inline">@ViewData["Title"]</span>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @(User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "User")
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </header>

        <div class="app-body">
            <aside class="app-sidebar d-none d-md-block">
                @await Html.PartialAsync("_SidebarNav")
            </aside>

            <div class="offcanvas offcanvas-start app-sidebar-offcanvas" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="appSidebarLabel">Menu</h5>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    @await Html.PartialAsync("_SidebarNav")
                </div>
            </div>

            <main role="main" class="app-content">
                @RenderBody()
                <footer class="app-footer text-muted small mt-4 pt-3 border-top">
                    &copy; 2026 - HR System - <a class="link-secondary" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </footer>
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
