@using System
@using System.Linq

@{
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).Trim();
    string Active(params string[] controllers) => controllers.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : string.Empty;
    bool IsActive(params string[] controllers) => controllers.Contains(controller, StringComparer.OrdinalIgnoreCase);
    string CollapseShow(params string[] controllers) => IsActive(controllers) ? "show" : string.Empty;
    string CollapseExpanded(params string[] controllers) => IsActive(controllers) ? "true" : "false";
    string CollapseButtonState(params string[] controllers) => IsActive(controllers) ? string.Empty : "collapsed";
    string GroupActive(params string[] controllers) => IsActive(controllers) ? "active" : string.Empty;
}

