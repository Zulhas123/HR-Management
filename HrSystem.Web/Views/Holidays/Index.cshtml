@model IReadOnlyList<HrSystem.Domain.Entities.Holiday>

@{
    ViewData["Title"] = "Holidays";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Holidays</h1>
    <a class="btn btn-primary" asp-action="Create">New Holiday</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Name</th>
            <th>Optional</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>@h.Date</td>
                <td>@h.Name</td>
                <td>@(h.IsOptional ? "Yes" : "No")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@h.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@h.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

