@model HrSystem.Web.ViewModels.ProductivityReportVm

@{
    ViewData["Title"] = "Productivity Report";
}

<h1 class="h3">Productivity Report</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-3 mb-3">
            <label asp-for="FromInclusive" class="form-label">From</label>
            <input asp-for="FromInclusive" type="date" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="ToInclusive" class="form-label">To</label>
            <input asp-for="ToInclusive" type="date" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="DepartmentId" class="form-label">Department</label>
            <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                <option value="">(all)</option>
            </select>
        </div>
        <div class="col-md-2 mb-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Run</button>
        </div>
    </div>
</form>

@if (Model.Report is not null)
{
    <h2 class="h5 mt-4">Teams</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Department</th>
                <th>Employees</th>
                <th>Tasks (assigned)</th>
                <th>Tasks (completed)</th>
                <th>Work log days</th>
                <th>WFH days</th>
                <th>Minutes logged</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Report.Teams)
            {
                <tr>
                    <td>@t.DepartmentName</td>
                    <td>@t.EmployeesCount</td>
                    <td>@t.TasksAssigned</td>
                    <td>@t.TasksCompleted</td>
                    <td>@t.WorkLogDays</td>
                    <td>@t.WorkFromHomeDays</td>
                    <td>@t.MinutesLogged</td>
                </tr>
            }
        </tbody>
    </table>

    <h2 class="h5 mt-4">Employees</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Department</th>
                <th>Tasks (assigned)</th>
                <th>Tasks (completed)</th>
                <th>Work log days</th>
                <th>WFH days</th>
                <th>Minutes logged</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Report.Employees)
            {
                <tr>
                    <td>@e.EmployeeCode - @e.FullName</td>
                    <td>@e.DepartmentName</td>
                    <td>@e.TasksAssigned</td>
                    <td>@e.TasksCompleted</td>
                    <td>@e.WorkLogDays</td>
                    <td>@e.WorkFromHomeDays</td>
                    <td>@e.MinutesLogged</td>
                </tr>
            }
        </tbody>
    </table>
}

