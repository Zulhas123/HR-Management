@model HrSystem.Web.ViewModels.OnboardingDocumentChecklistItemVm

@{
    ViewData["Title"] = "Add Document Item";
}

<h1 class="h3">Add Document Checklist Item</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EmployeeOnboardingId" />
    <div class="row g-3">
        <div class="col-md-8">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4">
                <input asp-for="IsRequired" class="form-check-input" />
                <label asp-for="IsRequired" class="form-check-label">Required</label>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4">
                <input asp-for="IsProvided" class="form-check-input" />
                <label asp-for="IsProvided" class="form-check-label">Provided</label>
            </div>
        </div>
        <div class="col-12">
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Add</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.EmployeeOnboardingId">Cancel</a>
</form>

