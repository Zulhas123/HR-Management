@model HrSystem.Web.ViewModels.OnboardingOrientationItemVm

@{
    ViewData["Title"] = "Add Orientation Item";
}

<h1 class="h3">Add Orientation Checklist Item</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EmployeeOnboardingId" />
    <div class="row g-3">
        <div class="col-md-8">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4">
                <input asp-for="IsCompleted" class="form-check-input" />
                <label asp-for="IsCompleted" class="form-check-label">Completed</label>
            </div>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label asp-for="CompletedBy" class="form-label">Completed By</label>
                <input asp-for="CompletedBy" class="form-control" />
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Add</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.EmployeeOnboardingId">Cancel</a>
</form>

