@model HrSystem.Web.ViewModels.OnboardingFormVm

@{
    ViewData["Title"] = "Create Onboarding";
}

<h1 class="h3">Create Onboarding</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="EmployeeId" class="form-label">Employee</label>
                <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select"></select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<HrSystem.Domain.Entities.OnboardingStatus>()" class="form-select"></select>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>

