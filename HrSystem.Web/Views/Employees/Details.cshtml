@model HrSystem.Domain.Entities.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.FirstName @Model.LastName</h1>
    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Core</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Code</dt>
                    <dd class="col-sm-8">@Model.EmployeeCode</dd>
                    <dt class="col-sm-4">Join Date</dt>
                    <dd class="col-sm-8">@Model.JoinDate</dd>
                    <dt class="col-sm-4">Resignation</dt>
                    <dd class="col-sm-8">@Model.ResignationDate</dd>
                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@Model.Department?.Name</dd>
                    <dt class="col-sm-4">Designation</dt>
                    <dd class="col-sm-8">@Model.Designation?.Name</dd>
                    <dt class="col-sm-4">Employment</dt>
                    <dd class="col-sm-8">@Model.EmploymentType?.Name</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Contact / Bangladesh</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>
                    <dt class="col-sm-4">NID</dt>
                    <dd class="col-sm-8">@Model.NidNumber</dd>
                    <dt class="col-sm-4">TIN</dt>
                    <dd class="col-sm-8">@Model.TinNumber</dd>
                    <dt class="col-sm-4">Bank</dt>
                    <dd class="col-sm-8">@Model.BankName @Model.BankAccountNumber</dd>
                    <dt class="col-sm-4">Mobile Banking</dt>
                    <dd class="col-sm-8">@Model.MobileBankingProvider @Model.MobileBankingNumber</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Files</h2>
                <div class="d-flex gap-2">
                    @if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
                    {
                        <div>
                            <div class="text-muted small">Photo</div>
                            <img src="@Model.PhotoPath" alt="Photo" class="img-thumbnail" style="max-height: 140px;" />
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SignaturePath))
                    {
                        <div>
                            <div class="text-muted small">Signature</div>
                            <img src="@Model.SignaturePath" alt="Signature" class="img-thumbnail" style="max-height: 140px;" />
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <a class="btn btn-outline-primary btn-sm" asp-controller="EmployeeDocuments" asp-action="Index" asp-route-employeeId="@Model.Id">
                        Manage Documents
                    </a>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="EmployeeEducations" asp-action="Index" asp-route-employeeId="@Model.Id">
                        Education
                    </a>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="EmployeeExperiences" asp-action="Index" asp-route-employeeId="@Model.Id">
                        Experience
                    </a>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="EmployeeTransfers" asp-action="Index" asp-route-employeeId="@Model.Id">
                        Transfers
                    </a>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="EmployeePromotions" asp-action="Index" asp-route-employeeId="@Model.Id">
                        Promotions
                    </a>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="EmployeeEmergencyContacts" asp-action="Index" asp-route-employeeId="@Model.Id">
                        Emergency Contacts
                    </a>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="EmployeeFamilyMembers" asp-action="Index" asp-route-employeeId="@Model.Id">
                        Family
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</div>
