@model HrSystem.Web.ViewModels.EmployeeFormVm

<div class="row g-3">
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="JoinDate" class="form-label"></label>
            <input asp-for="JoinDate" class="form-control" />
            <span asp-validation-for="JoinDate" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="DepartmentId" class="form-label">Department</label>
            <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select"></select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="DesignationId" class="form-label">Designation</label>
            <select asp-for="DesignationId" asp-items="Model.Designations" class="form-select"></select>
            <span asp-validation-for="DesignationId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="EmploymentTypeId" class="form-label">Employment Type</label>
            <select asp-for="EmploymentTypeId" asp-items="Model.EmploymentTypes" class="form-select"></select>
            <span asp-validation-for="EmploymentTypeId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="NidNumber" class="form-label">NID</label>
            <input asp-for="NidNumber" class="form-control" />
            <span asp-validation-for="NidNumber" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="TinNumber" class="form-label">TIN</label>
            <input asp-for="TinNumber" class="form-control" />
            <span asp-validation-for="TinNumber" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="PassportNumber" class="form-label">Passport</label>
            <input asp-for="PassportNumber" class="form-control" />
            <span asp-validation-for="PassportNumber" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="BiometricUserId" class="form-label">Biometric User ID</label>
            <input asp-for="BiometricUserId" class="form-control" />
            <span asp-validation-for="BiometricUserId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="FaceProfileId" class="form-label">Face Profile ID</label>
            <input asp-for="FaceProfileId" class="form-control" />
            <span asp-validation-for="FaceProfileId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="RfidCardId" class="form-label">RFID Card ID</label>
            <input asp-for="RfidCardId" class="form-control" />
            <span asp-validation-for="RfidCardId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="ResignationDate" class="form-label">Resignation Date</label>
            <input asp-for="ResignationDate" class="form-control" />
            <span asp-validation-for="ResignationDate" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="PresentAddress" class="form-label">Present Address</label>
            <textarea asp-for="PresentAddress" class="form-control" rows="2"></textarea>
            <span asp-validation-for="PresentAddress" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="PermanentAddress" class="form-label">Permanent Address</label>
            <textarea asp-for="PermanentAddress" class="form-control" rows="2"></textarea>
            <span asp-validation-for="PermanentAddress" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="ReligionId" class="form-label">Religion</label>
            <select asp-for="ReligionId" asp-items="Model.Religions" class="form-select">
                <option value="">(not set)</option>
            </select>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="BloodGroupId" class="form-label">Blood Group</label>
            <select asp-for="BloodGroupId" asp-items="Model.BloodGroups" class="form-select">
                <option value="">(not set)</option>
            </select>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-check mt-4">
            <input asp-for="IsFestivalEligible" class="form-check-input" />
            <label asp-for="IsFestivalEligible" class="form-check-label">Festival Eligible</label>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="BanglaFirstName" class="form-label">Bangla First Name</label>
            <input asp-for="BanglaFirstName" class="form-control" />
            <span asp-validation-for="BanglaFirstName" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="BanglaLastName" class="form-label">Bangla Last Name</label>
            <input asp-for="BanglaLastName" class="form-control" />
            <span asp-validation-for="BanglaLastName" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="BankName" class="form-label">Bank Name</label>
            <input asp-for="BankName" class="form-control" />
            <span asp-validation-for="BankName" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="BankAccountNumber" class="form-label">Bank Account Number</label>
            <input asp-for="BankAccountNumber" class="form-control" />
            <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="MobileBankingProvider" class="form-label">Mobile Banking Provider</label>
            <input asp-for="MobileBankingProvider" class="form-control" placeholder="bKash/Nagad/Rocket..." />
            <span asp-validation-for="MobileBankingProvider" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="MobileBankingNumber" class="form-label">Mobile Banking Number</label>
            <input asp-for="MobileBankingNumber" class="form-control" />
            <span asp-validation-for="MobileBankingNumber" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="PhotoFile" class="form-label">Photo</label>
            <input asp-for="PhotoFile" class="form-control" type="file" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="SignatureFile" class="form-label">Signature</label>
            <input asp-for="SignatureFile" class="form-control" type="file" />
        </div>
    </div>
</div>
