@model HrSystem.Web.ViewModels.OvertimeAutoGenerateVm

@{
    ViewData["Title"] = "Auto-generate OT";
}

<h1 class="h3">Auto-generate OT from Attendance</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="FromInclusive" class="form-label">From</label>
            <input asp-for="FromInclusive" type="date" class="form-control" />
            <span asp-validation-for="FromInclusive" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ToInclusive" class="form-label">To</label>
            <input asp-for="ToInclusive" type="date" class="form-control" />
            <span asp-validation-for="ToInclusive" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="CreateIfMissing" class="form-check-input" />
                <label asp-for="CreateIfMissing" class="form-check-label">Create if missing</label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Run</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

