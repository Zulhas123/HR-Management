@model HrSystem.Web.ViewModels.EmployeeAssetAssignmentVm

@{
    ViewData["Title"] = "Assign Asset";
}

<h1 class="h3">Assign Asset</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <partial name="_AssetForm" model="Model" />
    <button type="submit" class="btn btn-primary">Assign</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>

