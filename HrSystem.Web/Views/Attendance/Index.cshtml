@model IReadOnlyList<HrSystem.Domain.Entities.AttendanceRecord>

@{
    ViewData["Title"] = "Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Attendance</h1>
    <a class="btn btn-primary" asp-action="Create">New Record</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Employee</th>
            <th>Shift</th>
            <th>In</th>
            <th>Out</th>
            <th>Source</th>
            <th>Worked</th>
            <th>Late</th>
            <th>Early Exit</th>
            <th>Missing Punch</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Date</td>
                <td>@r.Employee?.EmployeeCode - @r.Employee?.FirstName @r.Employee?.LastName</td>
                <td>@r.Shift?.Name</td>
                <td>@r.CheckInTime</td>
                <td>@r.CheckOutTime</td>
                <td>@r.Source</td>
                <td>@(r.WorkedMinutes is null ? "" : $"{r.WorkedMinutes}m")</td>
                <td>@(r.LateMinutes is null ? "" : $"{r.LateMinutes}m")</td>
                <td>@(r.EarlyExitMinutes is null ? "" : $"{r.EarlyExitMinutes}m")</td>
                <td>@(r.MissingPunchStatus == HrSystem.Domain.Entities.MissingPunchStatus.None ? "" : r.MissingPunchStatus.ToString())</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@r.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
