@model HrSystem.Web.ViewModels.EmployeeTransferFormVm

@{
    ViewData["Title"] = "Edit Transfer";
}

<h1 class="h3">Edit Transfer</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EmployeeId" />
    <partial name="_TransferForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" asp-route-employeeId="@Model.EmployeeId" class="btn btn-secondary">Cancel</a>
</form>

