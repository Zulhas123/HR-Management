@model IReadOnlyList<HrSystem.Domain.Entities.EmployeeDocument>

@{
    var employee = (HrSystem.Domain.Entities.Employee)ViewData["Employee"]!;
    ViewData["Title"] = "Employee Documents";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Documents</h1>
        <div class="text-muted">@employee.EmployeeCode - @employee.FirstName @employee.LastName</div>
    </div>
    <a class="btn btn-primary" asp-action="Upload" asp-route-employeeId="@employee.Id">Upload</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Uploaded (UTC)</th>
            <th>File</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.DocumentName</td>
                <td>@d.DocumentType</td>
                <td>@d.UploadedAtUtc</td>
                <td><a href="@d.StoredPath" target="_blank">Open</a></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@d.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-secondary" asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id">Back</a>

