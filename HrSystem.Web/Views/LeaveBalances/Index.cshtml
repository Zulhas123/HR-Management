@model HrSystem.Web.ViewModels.LeaveBalanceIndexVm

@{
    ViewData["Title"] = "Leave Balances";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Leave Balances</h1>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label class="form-label">Employee</label>
        <select class="form-select" name="employeeId" asp-items="Model.Employees">
            <option value="">(select)</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Year</label>
        <input class="form-control" name="year" value="@Model.Year" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-primary" type="submit">View</button>
    </div>
</form>

@if (Model.EmployeeId is null)
{
    <div class="alert alert-info">Select an employee to view balances.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Leave Type</th>
                <th>Allocated</th>
                <th>Used</th>
                <th>Encashed</th>
                <th>Remaining</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Balances)
            {
                var remaining = Math.Max(0, b.AllocatedDays - b.UsedDays - b.EncashmentDays);
                <tr>
                    <td>@b.LeaveType?.Name</td>
                    <td>@b.AllocatedDays</td>
                    <td>@b.UsedDays</td>
                    <td>@b.EncashmentDays</td>
                    <td>@remaining</td>
                </tr>
            }
        </tbody>
    </table>
}

