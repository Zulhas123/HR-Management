@model HrSystem.Web.ViewModels.EmployeeFamilyMemberFormVm

@{
    ViewData["Title"] = "Add Family Member";
}

<h1 class="h3">Add Family Member</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EmployeeId" />
    <partial name="_FamilyMemberForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" asp-route-employeeId="@Model.EmployeeId" class="btn btn-secondary">Cancel</a>
</form>

