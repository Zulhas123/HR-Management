@model HrSystem.Web.ViewModels.EmployeeFamilyMemberFormVm

<div class="row g-3">
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="Relationship" class="form-label"></label>
            <input asp-for="Relationship" class="form-control" />
            <span asp-validation-for="Relationship" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" class="form-control" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
    </div>
    <div class="col-12">
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
</div>

