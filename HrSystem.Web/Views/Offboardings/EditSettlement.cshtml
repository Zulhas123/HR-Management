@model HrSystem.Web.ViewModels.FinalSettlementVm

@{
    ViewData["Title"] = "Final Settlement";
}

<h1 class="h3">Final Settlement</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EmployeeOffboardingId" />
    <div class="row g-3">
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="TotalPayable" class="form-label"></label>
                <input asp-for="TotalPayable" class="form-control" />
                <span asp-validation-for="TotalPayable" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="TotalDeductions" class="form-label"></label>
                <input asp-for="TotalDeductions" class="form-control" />
                <span asp-validation-for="TotalDeductions" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="PreparedBy" class="form-label">Prepared by</label>
                <input asp-for="PreparedBy" class="form-control" />
            </div>
        </div>
        <div class="col-12">
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.EmployeeOffboardingId">Cancel</a>
</form>

