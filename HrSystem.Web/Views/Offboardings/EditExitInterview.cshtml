@model HrSystem.Web.ViewModels.ExitInterviewVm

@{
    ViewData["Title"] = "Exit Interview";
}

<h1 class="h3">Exit Interview</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EmployeeOffboardingId" />
    <div class="row g-3">
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="InterviewDate" class="form-label"></label>
                <input asp-for="InterviewDate" class="form-control" />
                <span asp-validation-for="InterviewDate" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="Interviewer" class="form-label"></label>
                <input asp-for="Interviewer" class="form-control" />
            </div>
        </div>
        <div class="col-12">
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.EmployeeOffboardingId">Cancel</a>
</form>

