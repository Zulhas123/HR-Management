@model HrSystem.Web.ViewModels.ClearanceItemVm
@using HrSystem.Domain.Entities

@{
    ViewData["Title"] = "Add Clearance Item";
}

<h1 class="h3">Add Clearance Department</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EmployeeOffboardingId" />
    <div class="row g-3">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="DepartmentName" class="form-label">Department</label>
                <input asp-for="DepartmentName" class="form-control" />
                <span asp-validation-for="DepartmentName" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="Decision" class="form-label"></label>
                <select asp-for="Decision" asp-items="Html.GetEnumSelectList<ClearanceDecision>()" class="form-select"></select>
            </div>
        </div>
        <div class="col-12">
            <div class="mb-3">
                <label asp-for="Note" class="form-label"></label>
                <input asp-for="Note" class="form-control" />
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Add</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.EmployeeOffboardingId">Cancel</a>
</form>

