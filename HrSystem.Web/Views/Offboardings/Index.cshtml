@model IReadOnlyList<HrSystem.Domain.Entities.EmployeeOffboarding>

@{
    ViewData["Title"] = "Offboardings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Offboardings</h1>
    <a class="btn btn-primary" asp-action="Create">New Offboarding</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>EmployeeId</th>
            <th>Last Working Day</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.EmployeeId</td>
                <td>@o.LastWorkingDay</td>
                <td>@o.Status</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@o.Id">Details</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@o.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

