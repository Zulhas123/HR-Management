@model HrSystem.Domain.Entities.LeaveEncashmentRequest

@{
    ViewData["Title"] = "Delete Encashment";
}

<h1 class="h3">Delete Encashment Request</h1>
<p>Are you sure you want to delete this request?</p>

<dl class="row">
    <dt class="col-sm-2">Employee</dt>
    <dd class="col-sm-10">@Model.EmployeeId</dd>
    <dt class="col-sm-2">Leave Type</dt>
    <dd class="col-sm-10">@Model.LeaveTypeId</dd>
    <dt class="col-sm-2">Year</dt>
    <dd class="col-sm-10">@Model.Year</dd>
    <dt class="col-sm-2">Days</dt>
    <dd class="col-sm-10">@Model.DaysRequested</dd>
</dl>

<form method="post" asp-action="DeleteConfirmed">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>

