@model IReadOnlyList<HrSystem.Domain.Entities.LeaveEncashmentRequest>

@{
    ViewData["Title"] = "Leave Encashments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Leave Encashments</h1>
    <a class="btn btn-primary" asp-action="Create">New Request</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Type</th>
            <th>Year</th>
            <th>Days</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Employee?.EmployeeCode - @r.Employee?.FirstName @r.Employee?.LastName</td>
                <td>@r.LeaveType?.Name</td>
                <td>@r.Year</td>
                <td>@r.DaysRequested</td>
                <td>@r.Status</td>
                <td class="text-end">
                    @if (r.Status == HrSystem.Domain.Entities.LeaveEncashmentStatus.Pending)
                    {
                        <a class="btn btn-sm btn-outline-success" asp-action="Approve" asp-route-id="@r.Id">Approve</a>
                        <a class="btn btn-sm btn-outline-warning" asp-action="Reject" asp-route-id="@r.Id">Reject</a>
                    }
                    @if (r.Status == HrSystem.Domain.Entities.LeaveEncashmentStatus.Approved)
                    {
                        <form method="post" asp-action="MarkPaid" asp-route-id="@r.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-primary">Mark Paid</button>
                        </form>
                    }
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@r.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

