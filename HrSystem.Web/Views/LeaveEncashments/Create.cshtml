@model HrSystem.Web.ViewModels.LeaveEncashmentRequestFormVm

@{
    ViewData["Title"] = "Create Leave Encashment";
}

<h1 class="h3">Create Leave Encashment Request</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <partial name="_LeaveEncashmentForm" model="Model" />
    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>

