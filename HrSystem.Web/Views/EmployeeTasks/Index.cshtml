@model IReadOnlyList<HrSystem.Domain.Entities.EmployeeTask>

@{
    ViewData["Title"] = "Employee Tasks";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Employee Tasks</h1>
    <a class="btn btn-primary" asp-action="Create">New Task</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Assigned date</th>
            <th>Employee</th>
            <th>Title</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Due</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.AssignedDate</td>
                <td>@(t.Employee?.EmployeeCode ?? t.EmployeeId.ToString())</td>
                <td>@t.Title</td>
                <td>@t.Status</td>
                <td>@t.Priority</td>
                <td>@t.DueDate</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@t.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

