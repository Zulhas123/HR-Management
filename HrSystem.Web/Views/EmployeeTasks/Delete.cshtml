@model HrSystem.Domain.Entities.EmployeeTask

@{
    ViewData["Title"] = "Delete Task";
}

<h1 class="h3">Delete Task</h1>

<div class="alert alert-warning mt-3">
    Are you sure you want to delete task <strong>@Model.Title</strong>?
</div>

<form method="post" asp-action="DeleteConfirmed">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

