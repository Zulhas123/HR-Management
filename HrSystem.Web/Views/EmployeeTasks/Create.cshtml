@model HrSystem.Web.ViewModels.EmployeeTaskFormVm

@{
    ViewData["Title"] = "Create Task";
}

<h1 class="h3">Create Task</h1>

<form method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label"></label>
        <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select"></select>
        <span asp-validation-for="EmployeeId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Priority" class="form-label"></label>
            <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<HrSystem.Domain.Entities.EmployeeTaskPriority>()"></select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<HrSystem.Domain.Entities.EmployeeTaskStatus>()"></select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="AssignedDate" class="form-label"></label>
            <input asp-for="AssignedDate" type="date" class="form-control" />
            <span asp-validation-for="AssignedDate" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="DueDate" class="form-label"></label>
            <input asp-for="DueDate" type="date" class="form-control" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="CompletedDate" class="form-label"></label>
            <input asp-for="CompletedDate" type="date" class="form-control" />
            <span asp-validation-for="CompletedDate" class="text-danger"></span>
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="EstimatedMinutes" class="form-label"></label>
            <input asp-for="EstimatedMinutes" class="form-control" />
            <span asp-validation-for="EstimatedMinutes" class="text-danger"></span>
        </div>
        <div class="col-md-2 mb-3">
            <label asp-for="ActualMinutes" class="form-label"></label>
            <input asp-for="ActualMinutes" class="form-control" />
            <span asp-validation-for="ActualMinutes" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="AssignedBy" class="form-label"></label>
        <input asp-for="AssignedBy" class="form-control" />
        <span asp-validation-for="AssignedBy" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

