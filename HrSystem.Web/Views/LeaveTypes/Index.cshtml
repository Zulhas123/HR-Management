@model IReadOnlyList<HrSystem.Domain.Entities.LeaveType>

@{
    ViewData["Title"] = "Leave Types";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Leave Types</h1>
    <a class="btn btn-primary" asp-action="Create">New Leave Type</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Allocation</th>
            <th>Paid</th>
            <th>Approvals</th>
            <th>Encash</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.DefaultAnnualAllocation</td>
                <td>@(t.IsPaid ? "Yes" : "No")</td>
                <td>@t.ApprovalLevelsRequired</td>
                <td>@(t.AllowEncashment ? (t.MaxEncashmentDaysPerYear is null ? "Yes" : $"Yes (max {t.MaxEncashmentDaysPerYear})") : "No")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@t.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
