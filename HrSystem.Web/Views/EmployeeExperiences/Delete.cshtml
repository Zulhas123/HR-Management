@model HrSystem.Domain.Entities.EmployeeExperience

@{
    ViewData["Title"] = "Delete Experience";
}

<h1 class="h3">Delete Experience</h1>
<p class="text-muted">This action cannot be undone.</p>

<dl class="row">
    <dt class="col-sm-2">Company</dt>
    <dd class="col-sm-10">@Model.CompanyName</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" asp-route-employeeId="@Model.EmployeeId" class="btn btn-secondary">Cancel</a>
</form>

